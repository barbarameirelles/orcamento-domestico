# ── Supabase ────────────────────────────────────────────────────────────────
# Use a MESMA Project URL do app. Para a key, prefira a service_role
# (Settings -> API no Supabase). Ela ignora RLS e nunca vai pro navegador,
# entao pode ficar num backend como este com seguranca.
# Se preferir, pode usar a mesma anon key do app (VITE_SUPABASE_ANON_KEY).
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Grupo do WhatsApp ─────────────────────────────────────────────────────────
# Nome EXATO do grupo que o bot vai ouvir.
GROUP_NAME=APENAS GASTOS CASA

# ── Mapeamento de quem pagou ──────────────────────────────────────────────────
# Numero de cada pessoa (so digitos, com DDI e DDD). Quem enviar a mensagem
# vira o "payer" automaticamente. Ex: 5511987654321
WA_BARBARA=
WA_FELIPE=

# Pagador padrao quando o numero do remetente nao bater com nenhum acima.
DEFAULT_PAYER=barbara

# ── Ajustes ───────────────────────────────────────────────────────────────────
# Ignora mensagens mais antigas que N dias (evita reprocessar historico antigo
# na primeira execucao). 14 casa com a janela offline do WhatsApp.
IGNORE_OLDER_THAN_DAYS=14

# Fuso usado para a data do gasto.
TZ=America/Sao_Paulo

# Se "true", o bot responde no grupo confirmando cada gasto cadastrado.
REPLY_CONFIRMATION=true
